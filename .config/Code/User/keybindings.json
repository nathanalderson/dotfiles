// Place your key bindings in this file to override the defaults
[
    // ===================================================
    // Remove neovim bindings that remap ctrl-c (cuz that should copy)
    {
        "key": "ctrl+c",
        "command": "-vscode-neovim.escape",
        "when": "(editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert') && isLinux"
    },
    {
        "key": "cmd+c",
        "command": "-vscode-neovim.escape",
        "when": "(editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert') && isMac"
    },
    {
        "key": "ctrl+c",
        "command": "-vscode-neovim.escape",
        "when": "(editorTextFocus && neovim.ctrlKeysInsert && neovim.init && neovim.mode == 'insert') && isLinux"
    },
    {
        "key": "cmd+c",
        "command": "-vscode-neovim.escape",
        "when": "(editorTextFocus && neovim.ctrlKeysInsert && neovim.init && neovim.mode == 'insert') && isMac"
    },
    // ===================================================
    // Remove neovim bindings for <C-W>o which conflicts with ZoomWin
    {
        "command": "-workbench.action.joinAllGroups",
        "key": "ctrl+w ctrl+o",
        "when": "isLinux"
    },
    {
        "command": "-workbench.action.joinAllGroups",
        "key": "cmd+w cmd+o",
        "when": "isMac"
    },
    // ===================================================
    // Simulate NERDTree
    {
        "key": "ctrl+n",
        "command": "-workbench.action.files.newUntitledFile",
        "when": "isLinux"
    },
    {
        "key": "cmd+n",
        "command": "-workbench.action.files.newUntitledFile",
        "when": "isMac"
    },
    {
        "key": "ctrl+n",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "(!suggestWidgetVisible && !inQuickOpen) && isLinux"
    },
    {
        "key": "cmd+n",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "(!suggestWidgetVisible && !inQuickOpen) && isMac"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility",
        "when": "isLinux"
    },
    {
        "key": "cmd+b",
        "command": "-workbench.action.toggleSidebarVisibility",
        "when": "isMac"
    },
    // ===================================================
    // Toggle panel visibility
    {
        "key": "ctrl+m",
        "command": "workbench.action.togglePanel",
        "when": "isLinux"
    },
    {
        "key": "cmd+m",
        "command": "workbench.action.togglePanel",
        "when": "isMac"
    },
    {
        "key": "ctrl+j",
        "command": "-workbench.action.togglePanel",
        "when": "isLinux"
    },
    {
        "key": "cmd+j",
        "command": "-workbench.action.togglePanel",
        "when": "isMac"
    },
    // ===================================================
    // Ctrl+6 to switch tabs
    {
        "key": "ctrl+6",
        "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
        "when": "isLinux"
    },
    {
        "key": "cmd+6",
        "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
        "when": "isMac"
    },
    // ===================================================
